# --- Sensitive / local data: NEVER commit ---
# Anchored with a leading slash on purpose: an unanchored `vault/` matches at ANY
# depth, so it also ignored `src/sift/vault/` and kept that whole package — notes.py
# and schema.py — out of the repo. Same reasoning for data/ and models/.
.env
/vault/
!/vault/.gitkeep
*.lance
.lancedb/
/data/
/models/

# --- Python ---
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/

# --- distill working files: article excerpts and private vault paths (the repo is public) ---
/candidates*.jsonl
/verdicts*.jsonl

# --- Session handoff notes (transient) ---
HANDOFF.md

# --- Editors / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
