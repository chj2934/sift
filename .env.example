# Copy to .env and fill in. .env is gitignored.
# A blank value (`KEY=`) means "use the default".

# --- Reasoning (only `sift distill eval` calls the API; in-session gating needs no key) ---
# The SDK also finds `ant auth login` profiles, so this can stay blank.
ANTHROPIC_API_KEY=

# --- HackerOne API (pull your own reports + hacktivity) ---
# Create an API token at https://hackerone.com/settings/api_token/edit
# Username is your HackerOne username; token is the generated value.
H1_API_USERNAME=
H1_API_TOKEN=

# --- NVD API key (optional; raises rate limit from 5 to 50 req / 30s) ---
# Request one at https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# --- Hugging Face read token (optional; faster model + dataset downloads) ---
# Create at https://huggingface.co/settings/tokens  (type: Read)
# Once every model is downloaded you can also set HF_HUB_OFFLINE=1 (in .mcp.json's
# "env" or your shell) to skip Hub checks at startup; a new SIFT_EMBED_MODEL or
# SIFT_RERANK_MODEL then needs one online run first.
HF_TOKEN=

# --- sift paths (all optional; these are the defaults) ---
SIFT_VAULT_PATH=./vault
SIFT_DB_PATH=./data/lancedb
# Comma-separated folders every vault walker (listings, the catalog, reindex) skips.
# A bare name matches at any depth; a value with '/' is vault-relative,
# e.g. "Archive, finding/private". Dot- and _-folders (.obsidian, .trash) are always skipped.
SIFT_VAULT_IGNORE_DIRS=

# --- embeddings ---
# bge-base-en-v1.5 (768d) = good + fast on CPU. GPU users can bump to BAAI/bge-large-en-v1.5 (1024d).
# Changing this requires: sift reindex --force
SIFT_EMBED_MODEL=BAAI/bge-base-en-v1.5
# auto = GPU if torch+CUDA is available (uv sync --extra gpu), else CPU.
SIFT_EMBED_DEVICE=auto
# 0 = derive from the model (sift's table, then fastembed's model list). Set it for a
# model neither knows, e.g. a GPU-only sentence-transformers model; sift refuses to guess.
SIFT_EMBED_DIM=0
# Device for QUERY embeddings only; blank = same as SIFT_EMBED_DEVICE. `cpu` answers
# queries with fastembed's ONNX copy of the same model (identical rankings, ~3 s cold
# start instead of ~11 s, no VRAM) while indexing stays on SIFT_EMBED_DEVICE. The ONNX
# copy must be cached: the first query downloads it (with HF_HUB_OFFLINE=1 it falls
# back to the SIFT_EMBED_DEVICE backend instead).
SIFT_QUERY_DEVICE=

# --- retrieval ---
SIFT_RERANK=false
# Supported on CPU (fastembed): BAAI/bge-reranker-base, jinaai/jina-reranker-v2-base-multilingual,
# jinaai/jina-reranker-v1-turbo-en, jinaai/jina-reranker-v1-tiny-en,
# Xenova/ms-marco-MiniLM-L-6-v2, Xenova/ms-marco-MiniLM-L-12-v2.
# Others (e.g. BAAI/bge-reranker-v2-m3) need the gpu extra (sentence-transformers).
SIFT_RERANK_MODEL=BAAI/bge-reranker-base
# Ranking re-weights: 1.0 = full effect, 0.0 = ignore that factor.
SIFT_QUALITY_WEIGHT=1.0
SIFT_RECENCY_WEIGHT=1.0

# --- MCP server (sift mcp) ---
# Load the query model, reranker and link graph on a background thread once Claude
# Code connects, so the first search is fast. On cuda (with SIFT_QUERY_DEVICE blank)
# each concurrent Claude Code session then holds ~1.3 GB of VRAM; set
# SIFT_QUERY_DEVICE=cpu for a VRAM-free warm-up, or false to load on first use.
SIFT_MCP_WARMUP=true
# Sync vault edits (e.g. from Obsidian) into the index in the background. Changed notes
# are embedded inside the MCP process (the passage model loads there: ~1.3 GB VRAM on
# cuda); more than 200 changes are left for `sift reindex`.
SIFT_MCP_AUTO_SYNC=true

# --- novelty gate (sift distill) ---
# Must stay a Claude model: only the reasoning model can judge what it already knows.
SIFT_GATE_MODEL=claude-opus-5
# low|medium|high|xhigh|max. Higher = better judgement, more cost per candidate.
SIFT_GATE_EFFORT=low

# --- research feeds ---
# Extra RSS/Atom feed URLs for `sift ingest research`, comma-separated.
SIFT_RESEARCH_FEEDS=

# --- Google / Chromium sources ---
# Your Chromium checkout's `src` directory. Required by `sift ingest chromium-docs`
# and `chromium-fixes`; both record the checkout's HEAD sha on every note so a quote
# stays traceable to the revision it shipped with.
SIFT_CHROMIUM_SRC=
# The reasoning model's training cutoff, and the default horizon for every freshness
# source. Material older than this is what the model already knows, and storing it
# dilutes ranking. Set a little before the true cutoff: knowledge thins out near the
# boundary rather than stopping dead.
SIFT_MODEL_CUTOFF=2026-04-01
