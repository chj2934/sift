# Copy to .env and fill in. .env is gitignored.

# --- Reasoning (required for `sift distill` — the novelty gate is an API call) ---
ANTHROPIC_API_KEY=

# --- HackerOne API (pull your own reports + hacktivity) ---
# Create an API token at https://hackerone.com/settings/api_token/edit
# Username is your HackerOne username; token is the generated value.
H1_API_USERNAME=
H1_API_TOKEN=

# --- NVD API key (optional; raises rate limit from 5 to 50 req / 30s) ---
# Request one at https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# --- Hugging Face read token (optional; faster model + dataset downloads) ---
# Create at https://huggingface.co/settings/tokens  (type: Read)
HF_TOKEN=

# --- sift config (all optional; these are the defaults) ---
SIFT_VAULT_PATH=./vault
SIFT_DB_PATH=./data/lancedb
# bge-base-en-v1.5 (768d) = good + fast on CPU. GPU users can bump to BAAI/bge-large-en-v1.5 (1024d).
# Changing this requires: sift reindex --force
SIFT_EMBED_MODEL=BAAI/bge-base-en-v1.5
# auto = GPU if torch+CUDA is available (uv sync --extra gpu), else CPU.
SIFT_EMBED_DEVICE=auto
SIFT_RERANK=false

# --- novelty gate (sift distill) ---
# Must stay a Claude model: only the reasoning model can judge what it already knows.
SIFT_GATE_MODEL=claude-opus-5
# low|medium|high|xhigh|max. Higher = better judgement, more cost per candidate.
SIFT_GATE_EFFORT=low

# --- Google / Chromium sources ---
# Your Chromium checkout's `src` directory. Required by `sift ingest chromium-docs`
# and `chromium-fixes`; both record the checkout's HEAD sha on every note so a quote
# stays traceable to the revision it shipped with.
SIFT_CHROMIUM_SRC=
# The reasoning model's training cutoff, and the default horizon for every freshness
# source. Material older than this is what the model already knows, and storing it
# dilutes ranking. Set a little before the true cutoff: knowledge thins out near the
# boundary rather than stopping dead.
SIFT_MODEL_CUTOFF=2026-04-01
